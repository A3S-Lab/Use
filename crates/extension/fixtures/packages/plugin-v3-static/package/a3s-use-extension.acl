extension "acme/static" {
  schema_version = 3
  version        = "1.0.0"
  requires_use   = ">=0.3.0, <0.4.0"
  actions        = ["read"]

  repository {
    url      = "https://github.com/acme/static"
    revision = "0123456789abcdef0123456789abcdef01234567"
  }

  skill "guide" {
    path          = "skills/guide/SKILL.md"
    requires_tool = []
    requires_mcp  = []
    optional      = false
  }

  ui "panel" {
    entry     = "ui/panel/index.html"
    styles    = ["ui/panel/index.css"]
    scripts   = ["ui/panel/index.js"]
    skill     = "guide"
    bind_tool = []
    bind_mcp  = []
    optional  = false
  }
}
